; Extracted OCaml code is written to _build/default/extraction/.

(rocq.extraction
 (prelude ExtrQSort)
 (extracted_modules qsort)
 (theories Stdlib Paco Util HYLO Examples)
 (flags :standard -w -extraction-default-directory))

(rocq.extraction
 (prelude ExtrMSort)
 (extracted_modules msort)
 (theories Stdlib Paco Util HYLO Examples)
 (flags :standard -w -extraction-default-directory))

(rocq.extraction
 (prelude ExtrKnapsack)
 (extracted_modules knapsack)
 (theories Stdlib Paco Util HYLO Examples)
 (flags :standard -w -extraction-default-directory))

(rocq.extraction
 (prelude ExtrMutualRec)
 (extracted_modules mutualrec)
 (theories Stdlib Paco Util HYLO Examples)
 (flags :standard -w -extraction-default-directory))

(rocq.extraction
 (prelude ExtrShortcutFusion)
 (extracted_modules shortcutfusion)
 (theories Stdlib Paco Util HYLO Examples)
 (flags :standard -w -extraction-default-directory))

; Compile the extracted code, so that broken extraction is caught by the build.
; Uint63 comes from the Rocq kernel.

(library
 (name extracted)
 (modules qsort msort knapsack mutualrec shortcutfusion)
 (libraries rocq-runtime.kernel)
 (flags :standard -w -a))
